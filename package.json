{
  "name": "@local/dsh-lite-session-window",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Opens a Session on its newest Turns and folds the distant past behind on-demand paging, so the web client stays light.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "external": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
